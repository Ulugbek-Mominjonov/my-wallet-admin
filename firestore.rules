rules_version = '2';

// Oylik byudjet — Firestore xavfsizlik qoidalari.
//
// Asosiy tamoyil: BARCHA ma'lumot `users/{uid}` ostida. Shuning uchun
// egalik tekshiruvi bitta joyda hal bo'ladi va kelajakda oilaviy rejim
// qo'shilsa (`households/{id}` + `members`) faqat shu fayl kengayadi.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Yordamchilar ─────────────────────────

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function isIntOrNull(field) {
      return !(field in incoming())
          || incoming()[field] == null
          || incoming()[field] is int;
    }

    function isInt(field) {
      return field in incoming() && incoming()[field] is int;
    }

    function isNonNegative(field) {
      return !(field in incoming())
          || incoming()[field] == null
          || (incoming()[field] is int && incoming()[field] >= 0);
    }

    function isMonthKey(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // ───────────────────────── Foydalanuvchi ─────────────────────────

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && incoming().keys().hasOnly([
                        'displayName', 'email', 'timezone', 'currency',
                        'fcmTokens', 'createdAt', 'updatedAt'
                      ]);

      // ───── Xarajatlar ─────
      match /expenses/{id} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly([
               'name', 'category', 'method', 'planned', 'actual', 'dueDate',
               'monthKey', 'monthKeySource', 'status', 'debtId',
               'recurringId', 'autoPay', 'note', 'source',
               'createdAt', 'updatedAt'
             ])
          && incoming().name is string
          && incoming().category is string
          && incoming().method in ['card', 'cash']
          && isMonthKey(incoming().monthKey)
          // Pul HAR DOIM butun son — kasr kirib qolsa agregat buziladi.
          && isNonNegative('planned')
          && isNonNegative('actual')
          && incoming().status in ['paid', 'pending', 'overdue', 'none'];
      }

      // ───── Daromadlar ─────
      match /incomes/{id} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly([
               'amount', 'type', 'method', 'paidAt', 'monthKey', 'note',
               'debtId', 'source', 'createdAt', 'updatedAt'
             ])
          && isInt('amount')
          && incoming().amount > 0
          && incoming().type is string
          && incoming().method in ['card', 'cash']
          && isMonthKey(incoming().monthKey);
      }

      // ───── 👤 Shaxsiy fond sarflari ─────
      match /personalSpends/{id} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly([
               'amount', 'purpose', 'method', 'spentAt', 'monthKey',
               'note', 'createdAt', 'updatedAt'
             ])
          && isInt('amount')
          && incoming().amount > 0
          && isMonthKey(incoming().monthKey);
      }

      // ───── 💳 Qarzlar ─────
      // Hisoblagichlar (`paidFrom*`) klient tomonidan `increment` bilan
      // yangilanadi — bu ATAYLAB: offline ishlashi shart (§7.1).
      match /debts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly([
               'name', 'direction', 'total', 'paidBefore', 'monthly',
               'paidFromExpenses', 'paidFromIncomes', 'pendingFromApp',
               'dueDate', 'note', 'archived', 'createdAt', 'updatedAt'
             ])
          && isIntOrNull('total')
          && isIntOrNull('paidBefore')
          && isIntOrNull('monthly');
      }

      // ───── 🎯 Maqsadlar ─────
      match /goals/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly([
               'name', 'target', 'saved', 'monthly', 'deadline', 'note',
               'order', 'createdAt', 'updatedAt'
             ])
          && isIntOrNull('target')
          && isIntOrNull('saved');
      }

      // ───── ★ Oylik agregat ─────
      // Klient yozadi (delta) — bu ataylab, offline uchun. Xatoni kechasi
      // ishlaydigan reconciler tuzatadi (§7.1).
      match /months/{monthKey} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && isMonthKey(monthKey);
      }

      // ───── Katalog ─────
      match /recurring/{id} {
        allow read, write: if isOwner(uid);
      }
      match /limits/{id} {
        allow read, write: if isOwner(uid);
      }
      match /quickAdd/{id} {
        allow read, write: if isOwner(uid);
      }
      match /categories/{id} {
        allow read, write: if isOwner(uid);
      }
      match /settings/{doc} {
        allow read, write: if isOwner(uid);
      }

      // ───── meta ─────
      match /meta/totals {
        allow read, write: if isOwner(uid);
      }

      // 🩺 Reconciler hisoboti — FAQAT server yozadi (Admin SDK rules'dan
      // o'tmaydi). Klient uchun yozish taqiqlangan.
      match /meta/health {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Audit log — server yozadi, klient faqat o'qiydi.
      match /auditLog/{id} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Qolgan hamma narsa taqiqlangan.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
