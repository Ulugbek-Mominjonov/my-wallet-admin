{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "changelog-sections": [
    { "type": "feat", "section": "Yangi imkoniyatlar" },
    { "type": "fix", "section": "Tuzatishlar" },
    { "type": "perf", "section": "Tezlik" },
    { "type": "refactor", "section": "Qayta tuzish", "hidden": true },
    { "type": "test", "section": "Testlar", "hidden": true },
    { "type": "docs", "section": "Hujjatlar", "hidden": true },
    { "type": "ci", "section": "CI/CD", "hidden": true },
    { "type": "chore", "section": "Xizmat", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "my-wallet-admin",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
