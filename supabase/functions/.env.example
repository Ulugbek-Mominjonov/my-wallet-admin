# Lokal Edge Functions muhiti (`supabase start` o'qiydi): cp .env.example .env
# Bu qiymatlar faqat lokal/CI uchun. Staging/prod sirlari — GitHub Environment
# secrets, deploy ularni `supabase secrets set` bilan o'rnatadi (DEPLOY.md 9).
CRON_SECRET=local-cron-secret
TELEGRAM_WEBHOOK_SECRET=local-telegram-webhook-secret
# Ixtiyoriy — lokalda bo'sh: xabarlar "sozlanmagan" deb o'tkaziladi.
TELEGRAM_BOT_TOKEN=
FCM_SERVICE_ACCOUNT=
