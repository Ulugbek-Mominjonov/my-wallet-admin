# ───────────────────── Server-only (Secret) ─────────────────────
# base64(JSON) — Firebase service account kaliti. REPODA SAQLANMAYDI.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=oylik-byudjet-dev

# Vergul bilan ajratilgan uid'lar — faqat shular admin panelga kiradi.
ADMIN_UIDS=

# Cron endpointlarini himoyalaydi: `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# Telegram (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───────────────────── Brauzerga ochiq (public) ─────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=oylik-byudjet-dev
