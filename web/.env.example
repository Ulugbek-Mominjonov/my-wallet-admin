# Admin panel muhit o'zgaruvchilari (brauzerga OCHIQ — faqat publishable kalit).
# Lokal: `make web-env` lokal Supabase qiymatlari bilan .env.local yaratadi.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# local | staging | production
VITE_APP_ENV=local
# Telegram bot nomi (`t.me/<bot>`) — bildirishnomalarni ulash uchun (BR-163).
# Bo'sh bo'lsa sahifada "server sozlanmagan" ko'rsatiladi. Bot tokeni — serverda.
VITE_TELEGRAM_BOT=
